@model IReadOnlyList<Order>

<h1>Orders</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Create Order</a>

@if (Model.Count == 0)
{
    <p>No orders yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Order number</th>
                <th scope="col">Total quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.Items.Sum(item => item.Quantity)</td>
                </tr>
            }
        </tbody>
    </table>
}
